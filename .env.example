# =============================================================================
# Contoh variabel lingkungan — salin ke .env.local (lokal) atau Vercel → Settings
# JANGAN commit .env.local / kunci produksi.
# =============================================================================

# --- Wajib: proyek Supabase PEMBELI (bukan proyek lembaga lain) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- URL publik aplikasi (cadangan QR / tautan) ---
NEXT_PUBLIC_APP_URL=https://nama-situs-pembeli.vercel.app

# --- Merek (opsional; kosong = default Manarul Ilmi di kode) ---
# NEXT_PUBLIC_BRAND_NAME=Tahfizh Contoh Pesantren
# NEXT_PUBLIC_BRAND_SHORT=Contoh
# NEXT_PUBLIC_BRAND_TAGLINE=Platform Manajemen Tahfizh Terintegrasi
# NEXT_PUBLIC_BRAND_SIGNATURE=Tim Tahfizh Contoh
# NEXT_PUBLIC_BRAND_INSTITUTION=Lembaga Pendidikan Tahfizh Al-Qur'an
# NEXT_PUBLIC_LOGO_URL=/logo-mio-academy-on-light.png
# NEXT_PUBLIC_LOGO_ON_DARK=/logo-mio-academy-on-dark-v2.png
# Contoh clone Makassar (setelah scripts/process-brand-logo.py):
# NEXT_PUBLIC_LOGO_URL=/logo-rtmi-makassar-on-light.png
# NEXT_PUBLIC_LOGO_ON_LIGHT=/logo-rtmi-makassar-on-light.png
# NEXT_PUBLIC_LOGO_ON_DARK=/logo-rtmi-makassar-on-dark.png
# NEXT_PUBLIC_BRAND_COLOR=#047857

# --- Saklar fitur (default: nyala). Matikan dengan false / 0 / off ---
# NEXT_PUBLIC_FEATURE_PENGUMUMAN=true
# NEXT_PUBLIC_FEATURE_INPUT_MASSAL=true
# NEXT_PUBLIC_FEATURE_CETAK_KARTU=true
# NEXT_PUBLIC_FEATURE_LAPORAN=true
# NEXT_PUBLIC_FEATURE_WHATSAPP=true
# NEXT_PUBLIC_FEATURE_PORTAL_BADGE=true
# NEXT_PUBLIC_FEATURE_ABSENSI=true
# NEXT_PUBLIC_FEATURE_SPP=true

# Contoh: pembeli tidak pakai SPP / iuran
# NEXT_PUBLIC_FEATURE_SPP=false

# --- Akun demo (opsional): email yang tidak boleh ubah kata sandi di panel ---
# Satu email, atau beberapa dipisah koma. Harus sama dengan user di Supabase Auth.
# NEXT_PUBLIC_DEMO_EMAIL=demo@contoh.com
# NEXT_PUBLIC_DEMO_EMAIL=demo@contoh.com,trial@contoh.com
