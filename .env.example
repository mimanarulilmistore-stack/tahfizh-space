# Supabase (wajib — isi dari project pembeli, jangan salin kunci produksi)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publik aplikasi (untuk QR / tautan portal jika window.location belum ada)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Branding (kosongkan = default Tahfizh Space)
NEXT_PUBLIC_BRAND_NAME=Tahfizh Space
NEXT_PUBLIC_BRAND_TAGLINE=Platform Mutaba'ah & Setoran Hafalan Modern
NEXT_PUBLIC_BRAND_SIGNATURE=Tim Tahfizh Space
NEXT_PUBLIC_BRAND_INSTITUTION=Lembaga Pendidikan Tahfizh Al-Qur'an Modern & Terpadu
# Opsional. Kosong = pakai /brand-logo.png di folder public/.
# NEXT_PUBLIC_LOGO_URL=/brand-logo.png

# Feature flags — default ON. Mati hanya jika false / 0 / off
# NEXT_PUBLIC_FEATURE_PENGUMUMAN=true
# NEXT_PUBLIC_FEATURE_INPUT_MASSAL=true
# NEXT_PUBLIC_FEATURE_CETAK_KARTU=true
# NEXT_PUBLIC_FEATURE_LAPORAN=true
# NEXT_PUBLIC_FEATURE_WHATSAPP=true
# NEXT_PUBLIC_FEATURE_PORTAL_BADGE=true
